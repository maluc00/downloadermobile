<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KliprMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/klipr_bg</item>
        <item name="android:navigationBarColor">@color/klipr_bg</item>
        <item name="android:windowBackground">@color/klipr_bg</item>
    </style>

    <style name="Theme.KliprMobile.BottomSheet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/klipr_surface</item>
    </style>
</resources>
